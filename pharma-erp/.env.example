# =============================================================================
# Pharma ERP — environment contract
# =============================================================================
# Copy to `.env` at the repo root:  cp .env.example .env
# Every variable below is REQUIRED unless marked OPTIONAL. Both apps validate
# their own variables on startup and exit non-zero if any are missing or
# malformed (fail fast — see apps/api/src/config/env.validation.ts and
# apps/web/src/lib/env.ts).
# -----------------------------------------------------------------------------

NODE_ENV=development

# -----------------------------------------------------------------------------
# Postgres — local Docker container (docker-compose.yml)
# -----------------------------------------------------------------------------
# These three feed docker-compose only. The superuser is used for migrations;
# the application never connects as it (superusers BYPASS Row-Level Security).
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=pharma_erp
POSTGRES_PORT=5432

# The least-privilege application role created by docker/postgres/init/01-roles.sql.
# It is NOT a superuser and does NOT own the tables, so RLS is always enforced
# against it. Keep this in sync with the init script if you change it.
POSTGRES_APP_USER=pharma_app
POSTGRES_APP_PASSWORD=pharma_app_dev_password

# -----------------------------------------------------------------------------
# Database URLs
# -----------------------------------------------------------------------------
# DATABASE_URL — used by the running API (PrismaClient). Connects as the
# least-privilege app role so PostgreSQL RLS policies apply to every query.
DATABASE_URL="postgresql://pharma_app:pharma_app_dev_password@localhost:5432/pharma_erp?schema=public"

# MIGRATION_DATABASE_URL — used by `prisma migrate` / `prisma studio` only
# (wired as `directUrl` in packages/database/prisma/schema.prisma). Needs DDL
# rights, so it connects as the superuser. Never use this at runtime.
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharma_erp?schema=public"

# -----------------------------------------------------------------------------
# API (NestJS)
# -----------------------------------------------------------------------------
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API.
WEB_ORIGIN=http://localhost:3000
# OPTIONAL — log level: error | warn | log | debug | verbose
LOG_LEVEL=log

# -----------------------------------------------------------------------------
# Web (Next.js)
# -----------------------------------------------------------------------------
# Base URL of the API as reachable from the browser AND from Next.js server
# components. Must NOT have a trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Clerk (authentication)
# -----------------------------------------------------------------------------
# Get both keys from https://dashboard.clerk.com -> your app -> API keys.
# They MUST come from the same Clerk instance: the API refuses to boot if one is
# a test key and the other is live, because every token would then fail
# verification with no obvious clue why.
#
# The publishable key is inlined into the browser bundle (hence NEXT_PUBLIC_).
# The secret key must never reach the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# OPTIONAL but recommended in production. Comma-separated origins allowed to be
# a token's authorised party; a validly-signed token minted for any other site is
# rejected, which is what stops it being replayed against this API. Defaults to
# WEB_ORIGIN when omitted.
# CLERK_AUTHORIZED_PARTIES=https://erp.example.com

# Where Clerk's components send users. These match the app's routes; change both
# sides together or sign-in will bounce.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
