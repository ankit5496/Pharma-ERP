# NestJS and Next.js both rely on hoisted peer resolution for their plugin
# ecosystems; without this pnpm's strict isolation breaks decorator metadata.
auto-install-peers=true
strict-peer-dependencies=false

# ESLint 8 refuses to run when it can resolve a plugin to two different files,
# which pnpm's strictly-nested layout guarantees as soon as two shared configs
# (ours and eslint-config-next) each depend on eslint-plugin-import. Hoisting
# every eslint package to the workspace root gives exactly one instance.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=@typescript-eslint/*
