// =============================================================================
// Pharma ERP — Prisma schema
// =============================================================================
// Scope of this file today: Tenant, User, AuditLog, Item, Party,
// ComplianceLicence, JobWorkAgreement, JobWorkProduct, Bom, Batch,
// PackagingRequirement, and the full purchase / production / sales flows.


//
// Two rules apply to every model added from here on:
//
//   1. TENANT SCOPING — every tenant-scoped table carries `tenantId` (UUID) and
//      gets a Row-Level Security policy in a raw-SQL migration. Prisma-level
//      `where: { tenantId }` filters are a second layer, never the only one.
//   2. NO HARD DELETES on compliance-relevant tables — carry `deletedAt` and
//      filter it out in queries. AuditLog is stricter still: append-only,
//      enforced by a database trigger.
// =============================================================================

generator client {
  provider = "prisma-client-js"
  // Default output (node_modules/.prisma/client, surfaced as '@prisma/client').
  // A custom output directory would force this package's compiled .d.ts to
  // reference a relative path that does not exist inside dist/, so consumers
  // would silently lose every generated type.
}

datasource db {
  provider = "postgresql"
  // Runtime connection: the least-privilege `pharma_app` role, so RLS applies.
  url       = env("DATABASE_URL")
  // Migrations / Studio: the superuser, which needs DDL rights. Prisma uses
  // `directUrl` for migrate + introspect + studio and `url` for the client.
  directUrl = env("MIGRATION_DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// Mirrors USER_ROLES in packages/types/src/roles.ts. A compile-time assertion
/// in src/index.ts fails the build if the two lists ever diverge.
enum UserRole {
  ADMIN
  PURCHASE_MANAGER
  STORE_OFFICER
  PRODUCTION_OFFICER
  QUALITY_OFFICER
  SALES_MANAGER
  ACCOUNTANT
  MANAGEMENT
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

/// Mutations recorded in the audit trail.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
}
enum ItemCategory {
  RAW_MATERIAL
  PACKING_MATERIAL
  SEMI_FINISHED
  FINISHED_GOOD
}

enum ScheduleClassification {
  NONE
  H
  H1
  X
  G
}

enum PartyType {
  SUPPLIER
  CUSTOMER
  BOTH
  PRINCIPAL
}

enum PartyStatus {
  ACTIVE
  INACTIVE
}

enum LicenceType {
  MANUFACTURING
  GST
  NARCOTICS
  WHOLESALE_DRUG
  IMPORT_EXPORT
  OTHER
}

enum LicenceStatus {
  ACTIVE
  EXPIRED
  SURRENDERED
}

enum JobWorkBillingModel {
  OWN_PROCUREMENT
  PURE_CONVERSION
}

enum BomStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BatchType {
  MANUFACTURED
  PURCHASED
}

enum BatchStatus {
  IN_PROGRESS
  QC_PENDING
  RELEASED
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  CLOSED
  CANCELLED
}

enum GrnStatus {
  DRAFT
  POSTED
}

enum PurchaseInvoiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum WorkOrderStatus {
  DRAFT
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  DISPATCHED
  CANCELLED
}

enum SalesInvoiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}


// -----------------------------------------------------------------------------
// Tenant — the root of the multi-tenancy tree
// -----------------------------------------------------------------------------

/// One pharma manufacturing company. This is the ONLY model without a
/// `tenantId` column, because its own `id` IS the tenant id; its RLS policy
/// compares `id` against the session's current tenant instead.
model Tenant {
  id   String @id @default(uuid()) @db.Uuid
  /// URL-safe identifier used for tenant-specific routes and subdomains.
  slug String @unique @db.VarChar(63)
  name String @db.VarChar(255)

  status TenantStatus @default(TRIAL)

  /// Manufacturing licence number issued by the state FDA / drug controller.
  /// Nullable during onboarding; required before a batch can be released.
  drugLicenceNumber String? @map("drug_licence_number") @db.VarChar(64)
  gstin             String? @db.VarChar(15)
  /// IANA zone (e.g. "Asia/Kolkata"). Batch and expiry dates are legally
  /// meaningful, so they are rendered in the tenant's own zone, not the server's.
  timezone          String  @default("Asia/Kolkata") @db.VarChar(64)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft delete. A tenant is never physically removed — its records are
  /// retained for the statutory retention period.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  users                    User[]
  auditLogs                AuditLog[]
  items                    Item[]
  parties                  Party[]
  complianceLicences       ComplianceLicence[]
  jobWorkAgreements        JobWorkAgreement[]
  jobWorkProducts          JobWorkProduct[]
  packagingRequirements    PackagingRequirement[]
  packagingRequirementLines PackagingRequirementLine[]
  boms                     Bom[]
  bomLines                 BomLine[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderLines       PurchaseOrderLine[]
  grns                     Grn[]
  grnLines                 GrnLine[]
  purchaseInvoices         PurchaseInvoice[]
  purchaseInvoiceLines     PurchaseInvoiceLine[]
  workOrders               WorkOrder[]
  batches                  Batch[]
  salesOrders              SalesOrder[]
  salesOrderLines          SalesOrderLine[]
  salesInvoices            SalesInvoice[]
  salesInvoiceLines        SalesInvoiceLine[]

  @@index([deletedAt])
  @@map("tenants")

}

// -----------------------------------------------------------------------------
// User
// -----------------------------------------------------------------------------

/// A person who signs in. Authentication itself is delegated to an external
/// provider (not yet chosen/wired): `externalAuthId` is the join key to that
/// provider's user record, and no password material is ever stored here.
model User {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Subject id from the auth provider. Null until the invited user first
  /// completes sign-in.
  externalAuthId String? @unique @map("external_auth_id") @db.VarChar(255)

  email    String  @db.VarChar(320)
  fullName String  @map("full_name") @db.VarChar(255)
  phone    String? @db.VarChar(32)

  role   UserRole
  status UserStatus @default(INVITED)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  auditLogs       AuditLog[]
  releasedBatches Batch[]  @relation("BatchReleasedBy")

  /// Email is unique per tenant, not globally: the same person may legitimately
  /// hold accounts at two companies on the platform.
  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@index([tenantId, deletedAt])
  @@map("users")
}

// -----------------------------------------------------------------------------
// AuditLog
// -----------------------------------------------------------------------------

/// Append-only trail written automatically by the API's audit interceptor.
///
/// Append-only is enforced in two places: the API never exposes update/delete,
/// and a database trigger (see the RLS migration) raises an exception on any
/// UPDATE or DELETE. There is deliberately no `deletedAt` column — a row that
/// could be marked deleted would not be an audit trail.
model AuditLog {
  id       BigInt @id @default(autoincrement())
  tenantId String @map("tenant_id") @db.Uuid

  /// Prisma model name of the audited entity, e.g. "Batch".
  entityType String      @map("entity_type") @db.VarChar(64)
  /// Primary key of the audited row, stringified (keys are not all UUIDs).
  entityId   String      @map("entity_id") @db.VarChar(64)
  action     AuditAction

  /// Acting user. Null for system/background writes (migrations, jobs).
  userId String? @map("user_id") @db.Uuid
  /// Snapshot of the row before the change; null on CREATE.
  beforeJson Json? @map("before_json")
  /// Snapshot of the row after the change; null on DELETE.
  afterJson  Json? @map("after_json")

  /// Request correlation id, for tying an audit entry back to API logs.
  requestId String? @map("request_id") @db.VarChar(64)
  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent") @db.VarChar(512)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// The access pattern that matters: "what happened to this record".
  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// Item — product / material master
// -----------------------------------------------------------------------------

/// Every raw material, packing material, semi-finished and finished good used
/// or produced by the tenant. Referenced by every downstream flow: BOM, GRN,
/// batch, purchase invoice, sales invoice.
model Item {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Short reference code, unique within the tenant, e.g. "RM-001".
  code        String @db.VarChar(32)
  brandName   String @map("brand_name") @db.VarChar(255)
  /// INN / generic name. Required by CDSCO for Schedule H / H1 / X items.
  genericName String @map("generic_name") @db.VarChar(255)

  category               ItemCategory
  /// Defaults to NONE; drives dispensing rules and label requirements downstream.
  scheduleClassification ScheduleClassification @default(NONE) @map("schedule_classification")

  /// 6- or 8-digit HSN code for GST classification.
  hsnCode String  @map("hsn_code") @db.VarChar(8)
  /// GST rate as a percentage, e.g. 12.00 for 12 %. Decimal avoids
  /// floating-point rounding on tax calculations.
  gstRate Decimal @map("gst_rate") @db.Decimal(5, 2)

  /// Maximum Retail Price in INR. Null for raw / packing materials.
  mrp              Decimal? @db.Decimal(12, 2)
  /// When true, a ceiling-price check is enforced before a sales invoice is confirmed.
  isDpcoControlled Boolean  @default(false) @map("is_dpco_controlled")

  /// Free-text storage conditions printed on batch records and labels,
  /// e.g. "Store below 25 °C, protect from light".
  storageConditions String? @map("storage_conditions") @db.VarChar(500)

  /// Minimum stock quantity that triggers a purchase requisition.
  /// Decimal with 3 dp to handle items measured in grams or ml.
  reorderLevel  Decimal? @map("reorder_level") @db.Decimal(12, 3)
  /// Shelf life in days. Used to compute expiry date when a batch is manufactured.
  shelfLifeDays Int?     @map("shelf_life_days")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

    tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  boms                      Bom[]
  bomLines                  BomLine[]                  @relation("BomLineItem")
  purchaseOrderLines        PurchaseOrderLine[]
  grnLines                  GrnLine[]
  batches                   Batch[]
  salesOrderLines           SalesOrderLine[]
  jobWorkProducts           JobWorkProduct[]
  packagingRequirements     PackagingRequirement[]
  packagingRequirementLines PackagingRequirementLine[] @relation("PackagingRequirementLineItem")

  /// Item code is unique within a tenant, not globally.
  @@unique([tenantId, code])
  @@index([tenantId, category])
  @@index([tenantId, deletedAt])
  @@map("items")
}
// -----------------------------------------------------------------------------
// Party — supplier / customer / principal master
// -----------------------------------------------------------------------------

model Party {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  code   String      @db.VarChar(32)
  name   String      @db.VarChar(255)
  type   PartyType
  status PartyStatus @default(ACTIVE)

  gstin   String? @db.VarChar(15)
  pan     String? @db.VarChar(10)
  address String? @db.VarChar(500)

  contactName  String? @map("contact_name") @db.VarChar(255)
  contactPhone String? @map("contact_phone") @db.VarChar(32)
  contactEmail String? @map("contact_email") @db.VarChar(320)

  /// Supplier-specific: drug licence held by the supplier.
  supplierDrugLicence String? @map("supplier_drug_licence") @db.VarChar(64)
  /// Supplier-specific: net payment terms in days, e.g. 30 = net-30.
  paymentTermsDays    Int?    @map("payment_terms_days")

  /// Customer-specific: drug licence number.
  customerDrugLicence       String?   @map("customer_drug_licence") @db.VarChar(64)
  /// Customer-specific: expiry date of the customer's drug licence.
  customerDrugLicenceExpiry DateTime? @map("customer_drug_licence_expiry") @db.Date
  /// Customer-specific: maximum outstanding balance allowed.
  creditLimitAmount         Decimal?  @map("credit_limit_amount") @db.Decimal(12, 2)
  /// Customer-specific: credit period in days before payment is due.
  creditPeriodDays          Int?      @map("credit_period_days")

  /// True when this party is a brand owner for job-work agreements.
  isPrincipal Boolean @default(false) @map("is_principal")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  purchaseOrders    PurchaseOrder[]
  salesOrders       SalesOrder[]
  jobWorkAgreements JobWorkAgreement[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("parties")
}

// -----------------------------------------------------------------------------
// ComplianceLicence — manufacturing, GST, narcotics and other licences
// -----------------------------------------------------------------------------

/// A regulatory licence held by the tenant. Separate from Tenant.drugLicenceNumber
/// (a quick-access field); this table is the authoritative record with full
/// expiry tracking and renewal alerts.
model ComplianceLicence {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  licenceType      LicenceType   @map("licence_type")
  licenceNumber    String        @map("licence_number") @db.VarChar(64)
  issuingAuthority String        @map("issuing_authority") @db.VarChar(255)
  issueDate        DateTime      @map("issue_date") @db.Date
  expiryDate       DateTime      @map("expiry_date") @db.Date
  status           LicenceStatus @default(ACTIVE)

  /// Days before expiry to trigger a renewal alert. Defaults to 90.
  alertThresholdDays Int @default(90) @map("alert_threshold_days")

  /// Reference to a scanned copy stored outside the DB.
  documentUrl String? @map("document_url") @db.VarChar(500)
  remarks     String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, licenceType, licenceNumber])
  @@index([tenantId, licenceType])
  @@index([tenantId, status])
  @@index([tenantId, expiryDate])
  @@index([tenantId, deletedAt])
  @@map("compliance_licences")
}

// -----------------------------------------------------------------------------
// JobWorkAgreement + JobWorkProduct — principal & job-work agreement master
// -----------------------------------------------------------------------------

/// A job-work agreement between the tenant (manufacturer) and a Principal
/// (brand owner). billingModel drives whether the principal supplies raw
/// materials or the tenant procures everything and bills a conversion charge.
model JobWorkAgreement {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// The principal party. Must have isPrincipal = true.
  principalId     String              @map("principal_id") @db.Uuid
  agreementNumber String              @map("agreement_number") @db.VarChar(64)
  billingModel    JobWorkBillingModel @map("billing_model")

  /// Agreement-level conversion charge rate per unit (PURE_CONVERSION).
  conversionChargeRate Decimal? @map("conversion_charge_rate") @db.Decimal(12, 2)
  currency             String   @default("INR") @db.VarChar(8)

  effectiveDate DateTime  @map("effective_date") @db.Date
  expiryDate    DateTime? @map("expiry_date") @db.Date
  remarks       String?   @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  principal Party            @relation(fields: [principalId], references: [id], onDelete: Restrict)
  products  JobWorkProduct[]

  @@unique([tenantId, agreementNumber])
  @@index([tenantId, principalId])
  @@index([tenantId, deletedAt])
  @@map("job_work_agreements")
}

/// Maps a finished-good Item to a JobWorkAgreement — the product-to-brand
/// mapping. One item can appear under multiple agreements over time.
model JobWorkProduct {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  jobWorkAgreementId String @map("job_work_agreement_id") @db.Uuid
  itemId             String @map("item_id") @db.Uuid
  brandName          String @map("brand_name") @db.VarChar(255)
  /// Product-level override of the agreement conversion charge rate.
  conversionChargeRate Decimal? @map("conversion_charge_rate") @db.Decimal(12, 2)
  remarks              String?  @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  jobWorkAgreement JobWorkAgreement @relation(fields: [jobWorkAgreementId], references: [id], onDelete: Restrict)
  item             Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([tenantId, jobWorkAgreementId, itemId])
  @@index([tenantId, jobWorkAgreementId])
  @@index([tenantId, itemId])
  @@index([tenantId, deletedAt])
  @@map("job_work_products")
}

// -----------------------------------------------------------------------------
// Bom + BomLine — Bill of Materials / formulation master
// -----------------------------------------------------------------------------

/// BOM header. Belongs to one FINISHED_GOOD Item. Multiple versions allowed;
/// only one may be ACTIVE at a time — enforced by a partial unique index
/// hand-written in the RLS migration (Prisma cannot express partial indexes).
model Bom {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  itemId  String    @map("item_id") @db.Uuid
  version String    @db.VarChar(32)
  status  BomStatus @default(DRAFT)

  /// Standard batch size this BOM is written for. Work Orders scale quantities
  /// proportionally to their own planned quantity.
  batchSize    Decimal @map("batch_size") @db.Decimal(12, 3)
  batchSizeUom String  @map("batch_size_uom") @db.VarChar(16)
  remarks      String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item       Item        @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lines      BomLine[]
  workOrders WorkOrder[]

  @@unique([tenantId, itemId, version])
  @@index([tenantId, itemId, status])
  @@index([tenantId, deletedAt])
  @@map("boms")
}

model BomLine {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  bomId  String @map("bom_id") @db.Uuid
  itemId String @map("item_id") @db.Uuid

  quantity       Decimal  @db.Decimal(12, 3)
  uom            String   @db.VarChar(16)
  /// Optional overage/loss allowance as a percentage.
  overagePercent Decimal? @map("overage_percent") @db.Decimal(5, 2)
  remarks        String?  @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bom    Bom    @relation(fields: [bomId], references: [id], onDelete: Restrict)
  item   Item   @relation("BomLineItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([tenantId, bomId, itemId])
  @@index([tenantId, bomId])
  @@index([tenantId, deletedAt])
  @@map("bom_lines")
}

// -----------------------------------------------------------------------------
// PackagingRequirement + PackagingRequirementLine — packaging master
// -----------------------------------------------------------------------------

/// Packaging requirement header — one per finished-good Item per pack-size
/// variant (e.g. "10x10 Blister", "30ml Bottle").
model PackagingRequirement {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  itemId          String  @map("item_id") @db.Uuid
  packSizeVariant String  @map("pack_size_variant") @db.VarChar(64)
  unitsPerPack    Int     @map("units_per_pack")
  packsPerBatch   Int     @map("packs_per_batch")
  remarks         String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item   Item                       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lines  PackagingRequirementLine[]

  @@unique([tenantId, itemId, packSizeVariant])
  @@index([tenantId, itemId])
  @@index([tenantId, deletedAt])
  @@map("packaging_requirements")
}

/// One packaging component line. isMandatory = true causes a hard block on
/// Work Order / Dispatch when stock is short; false causes a warning only.
model PackagingRequirementLine {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  packagingRequirementId String @map("packaging_requirement_id") @db.Uuid
  /// Must be a PACKING_MATERIAL Item.
  itemId                 String @map("item_id") @db.Uuid
  /// Display label, e.g. "Bottle", "Cap", "Label", "Carton", "Insert".
  componentType          String @map("component_type") @db.VarChar(64)

  qtyPerPack  Decimal @map("qty_per_pack") @db.Decimal(12, 3)
  uom         String  @db.VarChar(16)
  isMandatory Boolean @default(true) @map("is_mandatory")
  remarks     String? @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  packagingRequirement PackagingRequirement @relation(fields: [packagingRequirementId], references: [id], onDelete: Restrict)
  item                 Item                 @relation("PackagingRequirementLineItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([tenantId, packagingRequirementId, itemId])
  @@index([tenantId, packagingRequirementId])
  @@index([tenantId, deletedAt])
  @@map("packaging_requirement_lines")
}

// -----------------------------------------------------------------------------
// Purchase flow: PurchaseOrder → Grn → PurchaseInvoice
// -----------------------------------------------------------------------------

model PurchaseOrder {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  poNumber  String              @map("po_number") @db.VarChar(32)
  partyId   String              @map("party_id") @db.Uuid
  status    PurchaseOrderStatus @default(DRAFT)
  orderDate DateTime            @map("order_date") @db.Date
  dueDate   DateTime?           @map("due_date") @db.Date
  remarks   String?             @db.VarChar(500)

