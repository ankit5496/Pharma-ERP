// -----------------------------------------------------------------------------
// Production flow: WorkOrder → Batch → QC release
// -----------------------------------------------------------------------------

model WorkOrder {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  woNumber      String          @map("wo_number") @db.VarChar(32)
  bomId         String          @map("bom_id") @db.Uuid
  status        WorkOrderStatus @default(DRAFT)
  plannedDate   DateTime        @map("planned_date") @db.Date
  completedDate DateTime?       @map("completed_date") @db.Date

  plannedQty Decimal @map("planned_qty") @db.Decimal(12, 3)
  uom        String  @db.VarChar(16)
  remarks    String? @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bom     Bom     @relation(fields: [bomId], references: [id], onDelete: Restrict)
  batches Batch[]

  @@unique([tenantId, woNumber])
  @@index([tenantId, status])
  @@index([tenantId, bomId])
  @@index([tenantId, deletedAt])
  @@map("work_orders")
}

/// MANUFACTURED: workOrderId set, grnLineId null.
/// PURCHASED: grnLineId set, workOrderId null.
model Batch {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  batchNumber String      @map("batch_number") @db.VarChar(64)
  itemId      String      @map("item_id") @db.Uuid
  type        BatchType
  status      BatchStatus @default(IN_PROGRESS)

  quantity          Decimal  @db.Decimal(12, 3)
  uom               String   @db.VarChar(16)
  manufacturingDate DateTime @map("manufacturing_date") @db.Date
  expiryDate        DateTime @map("expiry_date") @db.Date

  workOrderId String? @map("work_order_id") @db.Uuid
  grnLineId   String? @unique @map("grn_line_id") @db.Uuid

  releasedAt      DateTime? @map("released_at") @db.Timestamptz(6)
  releasedById    String?   @map("released_by_id") @db.Uuid
  rejectedAt      DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)
  remarks         String?   @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  workOrder  WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  grnLine    GrnLine?   @relation(fields: [grnLineId], references: [id], onDelete: Restrict)
  releasedBy User?      @relation("BatchReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)

  @@unique([tenantId, batchNumber])
  @@index([tenantId, itemId, status])
  @@index([tenantId, type])
  @@index([tenantId, deletedAt])
  @@map("batches")
}

