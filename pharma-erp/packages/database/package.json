{
  "name": "@pharma-erp/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:status": "dotenv -e ../../.env -- prisma migrate status",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "build": "dotenv -e ../../.env -- prisma generate && tsc -p tsconfig.json",
    "typecheck": "dotenv -e ../../.env -- prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@pharma-erp/types": "workspace:*"
  },
  "devDependencies": {
    "@pharma-erp/config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "eslint": "^8.57.1",
    "prisma": "^6.2.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7"
  }
}
